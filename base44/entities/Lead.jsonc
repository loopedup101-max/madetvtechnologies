{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "type": {
      "type": "string",
      "enum": [
        "migration",
        "contact"
      ],
      "default": "migration"
    },
    "domain": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "email",
    "type"
  ]
}