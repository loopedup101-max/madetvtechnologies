{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "plan_name": {
      "type": "string"
    },
    "plan_category": {
      "type": "string",
      "enum": [
        "standard",
        "high_performance",
        "commerce",
        "vps",
        "dedicated",
        "ai_tools",
        "agency"
      ],
      "default": "standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "pending"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "billing_period_months": {
      "type": "number",
      "default": 12
    },
    "domain": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true
    },
    "provisioning_status": {
      "type": "string",
      "enum": [
        "queued",
        "provisioning",
        "complete",
        "failed"
      ],
      "default": "queued"
    },
    "buyer_email": {
      "type": "string",
      "format": "email"
    },
    "checkout_id": {
      "type": "string"
    },
    "wix_subscription_id": {
      "type": "string"
    },
    "wix_order_id": {
      "type": "string"
    }
  },
  "required": [
    "plan_name",
    "plan_category",
    "billing_cycle",
    "price"
  ]
}